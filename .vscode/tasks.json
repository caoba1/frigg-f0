{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": {
            "regexp": ".*",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*ready in.*",
            "endsPattern": ".*" 
          }
        }
      ],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      }
    },
    {
      "label": "Build Backend (CMake)",
      "type": "shell",
      "command": "cmake --build ./backend/build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Backend Server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/build/yin_server",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
